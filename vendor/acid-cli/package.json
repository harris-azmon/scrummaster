{
    "name": "@scrummaster/acid-cli",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "CLI for scanning specs and ACID references and syncing them to local Fossil tickets, plus one-way Trello export. Forked from acai-sh/cli, retargeted from the app.acai.sh SaaS to a local Fossil-backed store.",
    "module": "index.ts",
    "type": "module",
    "keywords": [
        "acid",
        "fossil",
        "scrummaster",
        "cli",
        "spec-driven",
        "agent",
        "requirements"
    ],
    "files": [
        "dist",
        "README.md",
        "docs"
    ],
    "bin": {
        "acid": "dist/acid.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:npm": "bun build ./src/index.ts --target=node --outfile dist/acid.js",
        "build:release:linux-x64": "bun build ./src/index.ts --compile --target=bun-linux-x64-modern --outfile dist/acid-linux-x64",
        "build:release:linux-arm64": "bun build ./src/index.ts --compile --target=bun-linux-arm64-modern --outfile dist/acid-linux-arm64",
        "build:release:darwin-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64-modern --outfile dist/acid-darwin-x64",
        "build:release:darwin-arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64-modern --outfile dist/acid-darwin-arm64",
        "verify:npm-artifact": "node ./scripts/verify-npm-artifact.mjs",
        "prepack": "bun run build:npm",
        "test": "AGENT=1 bun test"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "commander": "^14.0.3",
        "js-yaml": "^4.1.0"
    }
}
