{
  "manifest_version": 1,
  "tools": {
    "gemini": {
      "artifact": "commands/scrummaster/*.toml",
      "command_style": "slash-colon",
      "example": "/scrummaster:setup",
      "needs_confirmation": false
    },
    "qwen": {
      "artifact": "commands/scrummaster/*.toml",
      "command_style": "slash-colon",
      "example": "/scrummaster:setup",
      "needs_confirmation": true
    },
    "claude": {
      "artifact": ".claude/commands/*.md and .claude-plugin/*",
      "command_style": "slash-dash",
      "example": "/scrummaster-setup",
      "needs_confirmation": false
    },
    "codex": {
      "artifact": "~/.codex/skills/<skill>/SKILL.md",
      "command_style": "dollar-dash",
      "example": "$scrummaster-setup",
      "needs_confirmation": true
    },
    "opencode": {
      "artifact": "~/.opencode/skill/<skill>/SKILL.md",
      "command_style": "slash-dash",
      "example": "/scrummaster-setup",
      "needs_confirmation": true
    },
    "antigravity": {
      "artifact": ".agent/workflows/<skill>.md and ~/.gemini/antigravity/global_workflows/<skill>.md",
      "command_style": "at-mention + slash",
      "example": "@scrummaster /setup",
      "needs_confirmation": true
    },
    "vscode": {
      "artifact": "scrummaster-vscode/skills/<skill>/SKILL.md",
      "command_style": "at-mention + slash",
      "example": "@scrummaster /setup",
      "needs_confirmation": true
    },
    "copilot": {
      "artifact": "~/.config/github-copilot/scrummaster.md",
      "command_style": "slash-dash",
      "example": "/scrummaster-setup",
      "needs_confirmation": true
    },
    "aix": {
      "artifact": "~/.config/aix/scrummaster.md",
      "command_style": "slash-dash",
      "example": "/scrummaster-setup",
      "needs_confirmation": true
    },
    "skillshare": {
      "artifact": "~/.config/skillshare/skills/<skill>/SKILL.md",
      "command_style": "slash-dash",
      "example": "/scrummaster-setup",
      "needs_confirmation": true
    }
  },
  "extensions": {
    "gemini": {
      "name": "scrummaster",
      "version": "0.2.0",
      "contextFileName": "GEMINI.md"
    },
    "qwen": {
      "name": "scrummaster",
      "version": "0.2.0",
      "contextFileName": "GEMINI.md"
    }
  },
  "skills": [
    {
      "id": "scrummaster",
      "template": "scrummaster",
      "name": "scrummaster",
      "description": "Context-driven development methodology. Understands projects set up with Scrummaster (via Gemini CLI or Claude Code). Use when working with scrummaster/ directories, stories, specs, plans, or when user mentions context-driven development.",
      "commands": {
        "gemini": "/scrummaster:info",
        "qwen": "/scrummaster:info",
        "claude": "/scrummaster-info",
        "codex": "$scrummaster-info",
        "opencode": "/scrummaster-info",
        "antigravity": "@scrummaster /info",
        "vscode": "@scrummaster /info",
        "copilot": "/scrummaster-info",
        "aix": "/scrummaster-info",
        "skillshare": "/scrummaster-info"
      },
      "enabled": {
        "gemini": true,
        "qwen": true,
        "claude": true,
        "codex": true,
        "opencode": true,
        "antigravity": true,
        "vscode": true,
        "copilot": true,
        "aix": true,
        "skillshare": true
      }
    },
